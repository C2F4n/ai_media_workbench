# Copy to .local/nginx-public.conf; replace media.example.com and both certificate paths.
# Loopback listeners work with a TCP tunnel (TLS target: 8443). For direct hosting, change the listen addresses
# only after configuring firewall rules. Never publish the backend port (8081).
worker_processes 1;
error_log logs/ai-media-workbench.error.log warn;
pid logs/ai-media-workbench.pid;

events {
    worker_connections 512;
}

http {
    default_type application/octet-stream;
    access_log off;
    server_tokens off;
    keepalive_timeout 65;
    client_max_body_size 3073m;

    server {
        listen 127.0.0.1:8089;
        server_name media.example.com;
        # Use a fixed canonical host, not a user-supplied Host header.
        return 308 https://media.example.com$request_uri;
    }

    server {
        listen 127.0.0.1:8443 ssl;
        server_name media.example.com;
        ssl_certificate "conf/ssl/fullchain.pem";
        ssl_certificate_key "conf/ssl/privkey.pem";
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_cache shared:AMW_TLS:10m;
        ssl_session_timeout 1d;
        ssl_session_tickets off;

        if ($host != media.example.com) { return 444; }

        location / {
            proxy_pass http://127.0.0.1:8081;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            # Replace incoming headers; do not trust visitor-supplied forwarding data.
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header Forwarded "";
            proxy_set_header X-Forwarded-Host "";
            proxy_set_header X-Forwarded-Port "";
            proxy_set_header Connection "";
            proxy_connect_timeout 5s;
            proxy_read_timeout 180s;
            proxy_send_timeout 180s;
            proxy_next_upstream off;
        }
    }
}
