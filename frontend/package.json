{
  "name": "ai-media-workbench-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm run check && vite build",
    "test": "playwright test",
    "test:offline": "node scripts/test-offline.mjs",
    "check": "npm run lint && node scripts/contracts.mjs --check && vue-tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "generate:api": "node scripts/contracts.mjs"
  },
  "dependencies": {
    "@lucide/vue": "1.61.0",
    "lucide": "1.57.0",
    "three": "^0.187.0",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-vue": "6.0.10",
    "eslint": "10.15.0",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-vue": "10.12.1",
    "globals": "17.14.0",
    "mailparser": "^3.9.40",
    "smtp-server": "^3.19.23",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.5",
    "vue-eslint-parser": "10.3.0",
    "vue-tsc": "3.3.13"
  }
}
