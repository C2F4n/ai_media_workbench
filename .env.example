DB_URL=jdbc:mysql://127.0.0.1:3306/ai_media_workbench?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&characterEncoding=UTF-8
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
COOKIE_SECURE=false
# 公网 HTTPS 部署请启用 SPRING_PROFILES_ACTIVE=public；该模式启用 Secure Cookie、
# HTTPS 请求检查及精确回环地址代理信任。不要将后端端口暴露给隧道/公网。
# SPRING_PROFILES_ACTIVE=public
REGISTRATION_ENABLED=true
# 未配置真实邮件时关闭注册；凭据仅在本机运行环境设置，不提交仓库。
REGISTRATION_MAIL_ENABLED=false
SMTP_HOST=your_smtp_host
SMTP_PORT=465
SMTP_USERNAME=your_sending_email
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM=your_sending_email
SMTP_AUTH=true
SMTP_SSL_ENABLED=true
SMTP_STARTTLS_ENABLED=false
MEDIA_STORAGE_ROOT=./storage
MEDIA_MAX_UPLOAD_SIZE=3GB
MEDIA_MAX_DURATION=15m
FFPROBE_PATH=ffprobe
MEDIA_PROBE_WORKER_ENABLED=true
FFMPEG_PATH=ffmpeg
TRANSCODE_TIMEOUT=5m
TRANSCODE_MAX_OUTPUT_SIZE=3GB
TRANSCODE_WORKER_ENABLED=true
# 0自动按CPU计算并发上限（1至4）；负载较高时不领取新任务，不强停已运行任务。
TASK_MAX_PARALLEL=0
TASK_ADAPTIVE_ENABLED=true
TASK_CPU_HIGH_WATERMARK=0.85
TASK_MEMORY_RESERVE=2GB
TASK_MEMORY_PER_TASK=1GB
TASK_START_INTERVAL=3s
ACCOUNT_CLEANUP_ENABLED=true
ACCOUNT_CLEANUP_INTERVAL_MS=5000
# 个人凭据加密主密钥文件：首次保存时自动生成，禁止提交或与数据库备份一起公开。
CLOUD_CREDENTIALS_KEY_FILE=./.local/cloud-credentials.key
# 本地文字AI；个人云端凭据在账户页保存。本文件不会自动加载。
LOCAL_AI_ENABLED=true
LOCAL_AI_PORT=18565
LOCAL_AI_MODEL=qwen3.5-9b
# 单次推理超时秒数；9B 处理整段字幕时预填更慢，需小于启动脚本的 --timeout。
LOCAL_AI_TIMEOUT_SECONDS=120
# 可选：后端与本地启动脚本必须使用相同值，不要提交真实密钥。
LOCAL_AI_API_KEY=
